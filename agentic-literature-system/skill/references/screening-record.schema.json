{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agentic Graphics screening record",
  "type": "object",
  "required": [
    "canonical_title",
    "authors",
    "identifiers",
    "canonical_urls",
    "source_records",
    "published_date",
    "updated_date",
    "event_type",
    "abstract",
    "known_corpus_status",
    "triage_status",
    "screening_status",
    "screening_reason",
    "screening_evidence",
    "extracted_system_evidence",
    "confidence"
  ],
  "properties": {
    "canonical_title": {"type": "string", "minLength": 1},
    "authors": {"type": "array", "items": {"type": "string"}},
    "identifiers": {"type": "object"},
    "canonical_urls": {"type": "array", "items": {"type": "string"}},
    "source_records": {"type": "array", "items": {"type": "object"}},
    "published_date": {"type": ["string", "null"]},
    "updated_date": {"type": ["string", "null"]},
    "event_type": {"type": ["string", "null"]},
    "abstract": {"type": "string"},
    "known_corpus_status": {"type": "string"},
    "triage_status": {"enum": ["retain", "needs_full_read", "reject_obvious"]},
    "screening_status": {"enum": ["core", "enabling_or_adjacent", "scope_dependent", "excluded", "unresolved"]},
    "screening_reason": {"type": "string", "minLength": 1},
    "exclusion_code": {"type": ["string", "null"]},
    "screening_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim", "source_url"],
        "properties": {
          "claim": {"type": "string", "minLength": 1},
          "source_url": {"type": "string", "minLength": 1},
          "section_or_page": {"type": ["string", "null"]}
        },
        "additionalProperties": true
      }
    },
    "extracted_system_evidence": {"type": "object"},
    "confidence": {"enum": ["High", "Medium", "Low"]}
  },
  "additionalProperties": true
}
